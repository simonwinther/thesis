   105	def clip_and_normalize(img):
   106	    if not np.isfinite(img).all():
   107	        raise ValueError("Cannot normalize an image containing NaN or infinite values.")
   108	
   109	    img_clipped = np.clip(img, np.quantile(img, 0.001), np.quantile(img, 0.999))
   110	    img_min = np.min(img_clipped)
   111	    img_range = np.max(img_clipped) - img_min
   112	    if img_range == 0:
   113	        return np.zeros_like(img_clipped)
   114	
   115	    img_normalized = (img_clipped - img_min) / img_range
   116	
   117	    return img_normalized
