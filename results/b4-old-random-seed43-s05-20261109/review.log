     2	
     3	import argparse
     4	from datetime import datetime, timezone
     5	from pathlib import Path
     6	import os
     7	import re
     8	import subprocess
     9	import time
    10	
    11	
    12	def main():
    13	    parser = argparse.ArgumentParser()
    14	    parser.add_argument("remote_sweep")
    15	    parser.add_argument("destination", type=Path)
    16	    parser.add_argument("--once", action="store_true")
    17	    parser.add_argument("--host", default="mostafa", choices=("mostafa", "hendrix"))
    18	    args = parser.parse_args()
    19	    args.destination.mkdir(parents=True, exist_ok=True)
    20	    ssh_transport = "ssh" if args.host == "hendrix" else "ssh -o BatchMode=yes -o ConnectTimeout=15"
    21	    command = ["rsync", "-azm", "--stats", "--timeout=60", "--max-size=5m",
    22	               "--exclude=code/", "--exclude=checkpoints/", "--exclude=__pycache__/",
    23	               "--include=*/", "--include=*.txt", "--include=*.json", "--include=*.csv",
    24	               "--include=*.log", "--include=*.md", "--exclude=*",
    25	               "-e", ssh_transport,
    26	               f"{args.host}:{args.remote_sweep}/", str(args.destination) + "/"]
    27	    deadline = time.monotonic() + 14 * 86400
    28	    while time.monotonic() < deadline:
    29	        try:
    30	            preview = subprocess.run(command[:1] + ["--dry-run"] + command[1:], check=True,
    31	                                     capture_output=True, text=True, timeout=120, env={**os.environ, "LC_ALL": "C"})
    32	            match = re.search(r"Total transferred file size: ([\d,]+) bytes", preview.stdout)
    33	            if not match:
    34	                raise RuntimeError("Transfer size unavailable")
    35	            size = int(match[1].replace(",", ""))
    36	            if size > 250 * 1024**2:
    37	                raise RuntimeError(f"Refusing result transfer of {size} bytes")
    38	            subprocess.run(command, check=True, capture_output=True, timeout=180)
    39	            status_path = args.destination / "status.txt"
    40	            status = status_path.read_text().strip() if status_path.exists() else "unknown"
    41	            print(datetime.now(timezone.utc).isoformat(), f"copied {size} bytes; sweep={status}", flush=True)
    42	            if status in ("complete", "finished-with-errors", "cancelled") or args.once:
    43	                (args.destination / "backup_status.txt").write_text(f"copied; sweep={status}\n")
    44	                return
    45	        except (subprocess.SubprocessError, RuntimeError) as error:
    46	            print(datetime.now(timezone.utc).isoformat(), f"backup retry: {error}", flush=True)
    47	            if args.once:
    48	                raise
    49	        time.sleep(600)
    50	    (args.destination / "backup_status.txt").write_text("stopped after 14 days; verify remaining results\n")
    51	
    52	
    53	if __name__ == "__main__":
    54	    main()
