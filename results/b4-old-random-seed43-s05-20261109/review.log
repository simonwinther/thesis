=== historical_source.py
     1	"""
     2	Starting sources for WFM-InformedSource.
     3	
     4	The flow path is x_t = (1-t)*s + t*x + sigma(t)*noise with velocity target
     5	x - s, so the source s is used in the interpolation, the velocity target and
     6	as the starting point at inference. Three sources are supported:
     7	
     8	  mean      s = mean of the available condition modalities (original WFM).
     9	  learned   s[b] = sum_m alpha[m, b](c, target_id) * c[m, b] for each of the
    10	            8 wavelet subbands b. alpha is a softmax over the available
    11	            condition modalities, computed independently per subband by a
    12	            small network that sees only the condition scans c, the
    13	            availability mask and the target modality ID. It never sees the
    14	            target image.
    15	  gaussian  s ~ N(0, I) in wavelet space. The UNet conditioning is unchanged.
    16	
    17	The learned source is a function of c and the target ID only, so it adds no
    18	conditioning information beyond what the UNet already receives.
    19	"""
    20	
    21	import math
    22	import random
    23	
    24	import torch as th
    25	import torch.nn as nn
    26	import torch.nn.functional as F
    27	
    28	ALL_MODALITIES = ["t1n", "t1c", "t2w", "t2f"]
    29	SUBBANDS = ["LLL", "LLH", "LHL", "LHH", "HLL", "HLH", "HHL", "HHH"]
    30	NUM_MODALITIES = len(ALL_MODALITIES)
    31	NUM_SUBBANDS = len(SUBBANDS)
    32	
    33	SOURCE_MODES = ("mean", "learned", "gaussian")
    34	SOURCE_INITS = ("uniform", "random", "biased")
    35	
    36	# Experimental setting for the "biased" initialization, not an established
    37	# prior: each target starts with extra weight on one partner modality from the
    38	# same weighting family (T1 pair, T2 pair). With all three conditions
    39	# available the partner starts at BIASED_PARTNER_WEIGHT and the other two
    40	# share the rest equally (0.6 / 0.2 / 0.2), in every subband.
    41	BIASED_PARTNER = {"t1n": "t1c", "t1c": "t1n", "t2w": "t2f", "t2f": "t2w"}
    42	BIASED_PARTNER_WEIGHT = 0.6
    43	
    44	
    45	def _biased_logit():
    46	    """Logit offset giving the partner BIASED_PARTNER_WEIGHT among three."""
    47	    other_weight = (1.0 - BIASED_PARTNER_WEIGHT) / 2.0
    48	    return math.log(BIASED_PARTNER_WEIGHT / other_weight)
    49	
    50	
    51	def initial_logits(init, init_std, generator):
    52	    """Per-target prior logits [target, modality, subband] at initialization."""
    53	    logits = th.zeros(NUM_MODALITIES, NUM_MODALITIES, NUM_SUBBANDS)
    54	    if init == "random":
    55	        logits.normal_(0.0, init_std, generator=generator)
    56	    elif init == "biased":
    57	        for target, partner in BIASED_PARTNER.items():
    58	            target_idx = ALL_MODALITIES.index(target)
    59	            partner_idx = ALL_MODALITIES.index(partner)
    60	            logits[target_idx, partner_idx, :] = _biased_logit()
    61	    elif init != "uniform":
    62	        raise ValueError(f"Unknown source init: {init}")
    63	    return logits
    64	
    65	
    66	def masked_subband_stats(cond_dwt, available):
    67	    """
    68	    Brain-masked mean and std of every condition subband.
    69	
    70	    Args:
    71	        cond_dwt: [B, 3, 8, D, H, W] condition wavelet coefficients
    72	        available: [B, 3] bool, False for missing conditions (already zeroed)
    73	
    74	    Returns:
    75	        stats: [B, 3, 8, 2]
    76	    """
    77	    brain = (cond_dwt[:, :, 0].abs().sum(dim=1) > 0).float()  # [B, D, H, W]
    78	    brain = brain[:, None, None]  # [B, 1, 1, D, H, W]
    79	    count = brain.sum(dim=(-3, -2, -1)).clamp_min(1.0)
    80	    mean = (cond_dwt * brain).sum(dim=(-3, -2, -1)) / count
    81	    centered = (cond_dwt - mean[..., None, None, None]) * brain
    82	    std = (centered.pow(2).sum(dim=(-3, -2, -1)) / count).sqrt()
    83	    stats = th.stack([mean, std], dim=-1)
    84	    return stats * available[:, :, None, None].float()
    85	
    86	
    87	class StartingSource(nn.Module):
    88	    """Builds the WFM starting source s from the available conditions."""
    89	
    90	    def __init__(
    91	        self,
    92	        mode="mean",
    93	        init="uniform",
    94	        init_std=0.1,
    95	        hidden_channels=128,
    96	        seed=42,
    97	    ):
    98	        super().__init__()
    99	        if mode not in SOURCE_MODES:
   100	            raise ValueError(f"Unknown source mode: {mode}")
   101	        if init not in SOURCE_INITS:
   102	            raise ValueError(f"Unknown source init: {init}")
   103	        self.mode = mode
   104	        self.init = init
   105	        self.init_std = init_std
   106	        self.hidden_channels = hidden_channels
   107	        self.seed = seed
   108	        self._noise_generator = None
   109	
   110	        if mode != "learned":
   111	            return
   112	
   113	        # Use a private RNG so adding this network leaves the UNet init, data
   114	        # order, timesteps and noise identical to the baseline run.
   115	        generator = th.Generator().manual_seed(seed + 1)
   116	        with th.random.fork_rng(devices=[]):
   117	            # th.manual_seed would also reseed CUDA, which fork_rng does not restore.
   118	            th.random.default_generator.manual_seed(seed + 1)
   119	            num_features = NUM_MODALITIES * NUM_SUBBANDS * 2 + 2 * NUM_MODALITIES
   120	            self.net = nn.Sequential(
   121	                nn.Linear(num_features, hidden_channels),
   122	                nn.SiLU(),
   123	                nn.Linear(hidden_channels, hidden_channels),
   124	                nn.SiLU(),
   125	                nn.Linear(hidden_channels, NUM_MODALITIES * NUM_SUBBANDS),
   126	            )
   127	        # A zero output layer makes the initial weights equal the prior logits
   128	        # for every subject. With the uniform prior that is exactly the mean.
   129	        nn.init.zeros_(self.net[-1].weight)
   130	        nn.init.zeros_(self.net[-1].bias)
   131	        self.prior_logits = nn.Parameter(initial_logits(init, init_std, generator))
   132	
   133	    def config(self):
   134	        return {
   135	            "mode": self.mode,
   136	            "init": self.init,
   137	            "init_std": self.init_std,
   138	            "hidden_channels": self.hidden_channels,
   139	            "seed": self.seed,
   140	        }
   141	
   142	    def weights(self, cond_dwt, cond_names, target_name, available):
   143	        """
   144	        Source weights alpha over the condition modalities.
   145	
   146	        Args:
   147	            cond_dwt: [B, 3, 8, D, H, W]
   148	            cond_names: modality names of the 3 condition slots
   149	            target_name: target modality name
   150	            available: [B, 3] bool
   151	
   152	        Returns:
   153	            alpha: [B, 3, 8], sums to 1 over available slots per subband
   154	        """
   155	        B = cond_dwt.shape[0]
   156	        device = cond_dwt.device
   157	        target_idx = ALL_MODALITIES.index(target_name)
   158	        slot_idx = th.tensor([ALL_MODALITIES.index(m) for m in cond_names], device=device)
   159	
   160	        stats = masked_subband_stats(cond_dwt, available)  # [B, 3, 8, 2]
   161	        slot_stats = th.zeros(B, NUM_MODALITIES, NUM_SUBBANDS, 2, device=device)
   162	        slot_stats[:, slot_idx] = stats
   163	        slot_available = th.zeros(B, NUM_MODALITIES, device=device)
   164	        slot_available[:, slot_idx] = available.float()
   165	        target_onehot = F.one_hot(
   166	            th.full((B,), target_idx, device=device), NUM_MODALITIES
   167	        ).float()
   168	        features = th.cat(
   169	            [slot_stats.flatten(1), slot_available, target_onehot], dim=1
   170	        )
   171	
   172	        logits = self.net(features).view(B, NUM_MODALITIES, NUM_SUBBANDS)
   173	        logits = logits + self.prior_logits[target_idx]
   174	        logits = logits[:, slot_idx]  # [B, 3, 8]
   175	        logits = logits.masked_fill(~available[:, :, None], float("-inf"))
   176	        return th.softmax(logits, dim=1)
   177	
   178	    def _gaussian(self, shape, device):
   179	        if self._noise_generator is None or self._noise_generator.device != device:
   180	            self._noise_generator = th.Generator(device=device).manual_seed(self.seed + 2)
   181	        return th.randn(shape, generator=self._noise_generator, device=device)
   182	
   183	    def forward(self, cond_dwt, cond_names, target_name, available):
   184	        """
   185	        Args:
   186	            cond_dwt: [B, 24, D, H, W] in the UNet condition layout
   187	            cond_names: modality names of the 3 condition slots
   188	            target_name: target modality name
   189	            available: [B, 3] bool
   190	
   191	        Returns:
   192	            source: [B, 8, D, H, W]
   193	            alpha: [B, 3, 8] effective weights, or None for the gaussian source
   194	        """
   195	        B, _, D, H, W = cond_dwt.shape
   196	        cond = cond_dwt.view(B, 3, NUM_SUBBANDS, D, H, W)
   197	
   198	        if self.mode == "gaussian":
   199	            return self._gaussian((B, NUM_SUBBANDS, D, H, W), cond_dwt.device), None
   200	
