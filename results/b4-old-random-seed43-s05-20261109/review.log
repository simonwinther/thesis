    69	def masked_subband_stats(cond_dwt, available):
    70	    """
    71	    Brain-masked mean and std of every condition subband.
    72	
    73	    Args:
    74	        cond_dwt: [B, 3, 8, D, H, W] condition wavelet coefficients
    75	        available: [B, 3] bool, False for missing conditions (already zeroed)
    76	
    77	    Returns:
    78	        stats: [B, 3, 8, 2]
    79	    """
    80	    brain = (cond_dwt[:, :, 0].abs().sum(dim=1) > 0).float()  # [B, D, H, W]
