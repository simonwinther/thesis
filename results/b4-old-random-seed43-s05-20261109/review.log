     1	"""Execute one immutable sweep entry; keep small results and final weights."""
     2	
     3	from datetime import datetime, timezone
     4	import hashlib
     5	from importlib import metadata
     6	import json
     7	import math
     8	import os
     9	from pathlib import Path
    10	import shutil
    11	import subprocess
    12	import sys
    13	
    14	import torch
    15	
    16	
    17	def main():
    18	    plan = json.loads(Path(sys.argv[1]).read_text())
    19	    job = plan["jobs"][int(sys.argv[2])]
    20	    out = Path(job["directory"])
    21	    status = out / "status.txt"
    22	    preflight_only = '--preflight-only' in sys.argv[3:]
    23	    if status.read_text().strip() != "queued":
    24	        raise RuntimeError("Refusing to rerun an entry that has already started")
    25	    try:
    26	        if shutil.disk_usage(out).free < 30 * 1024**3:
    27	            raise RuntimeError("Less than 30 GiB free; refusing to fill shared storage")
    28	        manifest = json.loads((Path(plan["sweep"]) / "code_sha256.json").read_text())
    29	        for name, digest in manifest.items():
    30	            assert hashlib.sha256((Path(plan["code"]) / name).read_bytes()).hexdigest() == digest, name
    31	        operation_manifest = json.loads((Path(plan["sweep"]) / "operations_sha256.json").read_text())
    32	        for name, digest in operation_manifest.items():
    33	            assert hashlib.sha256((Path(plan["sweep"]) / "operations" / name).read_bytes()).hexdigest() == digest, name
    34	        if not preflight_only and not torch.cuda.is_available():
    35	            raise RuntimeError('Training requires a GPU allocation')
    36	        batch_size = int(plan.get('batch_size', 4))
    37	        mixed_targets = plan.get('mixed_targets', True)
