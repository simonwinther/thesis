    39	# Experimental setting for the "biased" initialization, not an established
    40	# prior: each target starts with extra weight on one partner modality from the
    41	# same weighting family (T1 pair, T2 pair). With all three conditions
    42	# available the partner starts at BIASED_PARTNER_WEIGHT and the other two
    43	# share the rest equally (0.6 / 0.2 / 0.2), in every subband.
    44	BIASED_PARTNER = {"t1n": "t1c", "t1c": "t1n", "t2w": "t2f", "t2f": "t2w"}
    45	BIASED_PARTNER_WEIGHT = 0.6
    46	
    47	
    48	def _biased_logit():
    49	    """Logit offset giving the partner BIASED_PARTNER_WEIGHT among three."""
    50	    other_weight = (1.0 - BIASED_PARTNER_WEIGHT) / 2.0
