   275	        # Select modality for this step
   276	        contr = self._select_modality()
   277	
   278	        # Sample timesteps uniformly
   279	        t = th.randint(0, self.wfm.num_timesteps, (self.batch_size,),
   280	                       device=dist_util.dev())
   281	
   282	        # Available conditions (all three unless --num_available < 3)
   283	        if self.mixed_targets:
   284	            cond_names = [[m for m in ALL_MODALITIES if m != target] for target in contr]
   285	            available = [sample_available(names, self.num_available, self.available_rng) for names in cond_names]
   286	        else:
   287	            cond_names = [m for m in ALL_MODALITIES if m != contr]
   288	            available = sample_available(cond_names, self.num_available, self.available_rng)
   289	
   290	        # Compute loss
   291	        losses, model_output, model_output_idwt = self.wfm.training_losses(
   292	            model=self.model,
   293	            x_start=batch,
   294	            t=t,
   295	            source_model=self.source_model,
   296	            mode='i2i',
   297	            contr=contr,
   298	            available=available,
   299	        )
   300	
   301	        # Store per-channel losses for logging
   302	        self._last_channel_losses = losses["mse_wav"]
   303	        self._last_modality = contr
   304	        self._last_source_weights = losses["source_weights"]
   305	        self._last_cond_names = losses["cond_names"]
   306	        self._last_model_input_shape = losses['model_input_shape']
   307	        if self.mixed_targets:
   308	            if losses['cond_names'] != cond_names:
   309	                raise RuntimeError("Actual WFM conditions do not match per-sample assignments")
   310	            if losses['model_input_shape'][0] != self.batch_size:
   311	                raise RuntimeError("Mixed-target experiment did not use a physical batch of four")
   312	            expected_ids = [MODALITY_TO_CLASS[target] for target in contr]
   313	            if losses['target_ids'].tolist() != expected_ids:
   314	                raise RuntimeError("Model class labels do not match per-sample target assignment")
   315	            audit_path = os.path.join(logger.get_dir(), 'batch_targets.csv')
   316	            new_file = not os.path.exists(audit_path)
   317	            with open(audit_path, 'a', newline='') as stream:
   318	                writer = csv.writer(stream)
   319	                if new_file:
   320	                    writer.writerow(['step', 'sample', 'subject', 'target', 'condition_1', 'condition_2', 'condition_3'])
