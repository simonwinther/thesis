    50	                                         [f'patient-{i // 2}' for i in range(len(ds))], 4)
    51	    data = torch.utils.data.DataLoader(ds, num_workers=workers, batch_sampler=sampler)
    52	    model = Probe()
    53	    source = StartingSource('learned', init, seed=43, architecture='conditional')
    54	    loop = BridgeTrainLoop(model, source, WaveletFlowMatching(sigma_max=0), data,
    55	                          batch_size=4, lr=1e-5, source_lr=1e-3, weight_decay=0,
    56	                          log_interval=1, save_interval=13, resume_step=0,
    57	                          max_iterations=13, contr='all', mixed_targets=True,
    58	                          save_optimizer=False, recovery_interval=interval)
    59	    original = loop.run_step
    60	    def run_step(batch):
    61	        if loop.step + loop.resume_step == interrupt_at:
    62	            raise InterruptedError('Simulated preemption after uncommitted updates')
    63	        return original(batch)
    64	    loop.run_step = run_step
    65	    try:
    66	        loop.run_loop()
    67	    except InterruptedError:
    68	        shutdown(loop)
    69	        return None
