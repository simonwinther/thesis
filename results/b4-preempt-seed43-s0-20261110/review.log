    16	class DistinctPatientBatchSampler:
    17	    """Repair a random case permutation; only the final incomplete batch is dropped."""
    18	
    19	    def __init__(self, sampler, patients, batch_size=4):
    20	        self.sampler = sampler
    21	        self.patients = tuple(patients)
    22	        self.batch_size = batch_size
    23	        self.epoch_batches = None
    24	        self.resume_epoch = None
    25	        if batch_size < 1 or len(set(self.patients)) < batch_size:
    26	            raise ValueError('Not enough distinct patients for a full batch')
    27	
    28	    def __len__(self):
    29	        return len(self.sampler) // self.batch_size
    30	
    31	    def __iter__(self):
    32	        if self.resume_epoch is not None:
    33	            batches, offset = self.resume_epoch
    34	            self.resume_epoch = None
    35	            self.epoch_batches = batches
    36	            yield from batches[offset:]
    37	            return
    38	        order = list(self.sampler)
    39	        if len(set(order)) != len(order) or any(i < 0 or i >= len(self.patients) for i in order):
    40	            raise ValueError('Expected distinct valid case indices from the sampler')
    41	        width = self.batch_size
    42	        stop = len(order) // width * width
    43	        for start in range(0, stop, width):
    44	            end, seen = start + width, set()
    45	            for position in range(start, end):
    46	                duplicate = self.patients[order[position]]
    47	                if duplicate in seen:
    48	                    occupied = {self.patients[order[i]] for i in range(start, end) if i != position}
    49	                    replacement = next((i for i in range(end, len(order))
    50	                                        if self.patients[order[i]] not in occupied), None)
    51	                    if replacement is None:
    52	                        # Repair a short final tail without dropping any extra visits.
    53	                        for i in range(start):
    54	                            earlier_start = i // width * width
    55	                            earlier = {self.patients[order[j]]
    56	                                       for j in range(earlier_start, earlier_start + width) if j != i}
    57	                            if self.patients[order[i]] not in occupied and duplicate not in earlier:
    58	                                replacement = i
    59	                                break
    60	                    if replacement is None:
    61	                        raise ValueError('Cannot form full batches with distinct patients')
    62	                    order[position], order[replacement] = order[replacement], order[position]
    63	                seen.add(self.patients[order[position]])
    64	        # Repair is completed before yielding, since a final-tail swap may change an earlier batch.
    65	        self.epoch_batches = []
    66	        for start in range(0, stop, width):
    67	            batch = order[start:start + width]
    68	            if len({self.patients[i] for i in batch}) != width:
    69	                raise RuntimeError('Patient batch repair failed')
    70	            self.epoch_batches.append(batch)
    71	        for batch in self.epoch_batches:
    72	            yield batch
