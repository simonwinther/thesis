    78	def equal(a, b):
    79	    if isinstance(a, torch.Tensor):
    80	        torch.testing.assert_close(a, b, rtol=0, atol=0)
    81	    elif isinstance(a, dict):
    82	        assert a.keys() == b.keys()
    83	        for key in a:
    84	            equal(a[key], b[key])
    85	    elif isinstance(a, (list, tuple)):
    86	        assert len(a) == len(b)
    87	        for x, y in zip(a, b):
    88	            equal(x, y)
    89	    else:
    90	        assert a == b, (a, b)
