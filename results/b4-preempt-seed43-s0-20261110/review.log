    43	def train(directory, init, workers, interval, interrupt_at=None):
    44	    torch.manual_seed(43)
    45	    np.random.seed(43)
    46	    random.seed(43)
    47	    logger.configure(dir=str(directory), format_strs=['log'] if interval else ['log', 'csv'])
