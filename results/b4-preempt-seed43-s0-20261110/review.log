   266	    def run_step(self, batch):
   267	        """Single training step."""
   268	        if self.mixed_targets:
   269	            subjects = batch.get('subj', [])
   270	            if len(subjects) != self.batch_size or len({patient_id(s) for s in subjects}) != self.batch_size:
   271	                raise ValueError(f'Mixed-target batches require {self.batch_size} distinct patients, not just scan IDs')
