1	"""Atomic recovery for deterministic BraTS loading and mixed-target training."""
     2	
     3	import csv
     4	import hashlib
     5	import json
     6	import os
     7	from pathlib import Path
     8	import random
     9	import time
    10	
    11	import numpy as np
    12	import torch
    13	
    14	
    15	class TrainingRecovery:
    16	    def __init__(self, loop, directory):
    17	        self.loop = loop
    18	        self.directory = Path(directory)
    19	        self.root = self.directory / 'recovery'
    20	        self.root.mkdir(exist_ok=True)
    21	        self.consumed = 0
    22	        self.previous_elapsed = 0.0
    23	        self.started = time.monotonic()
    24	        sampler = loop.datal.batch_sampler
    25	        if not hasattr(sampler, 'epoch_batches'):
    26	            raise ValueError('Recovery requires the distinct-patient batch sampler')
    27	        database = getattr(loop.datal.dataset, 'database', list(sampler.patients))
    28	        self.identity = dict(
    29	            source=loop.source_model.config(), batch_size=loop.batch_size,
    30	            mixed_targets=loop.mixed_targets, max_iterations=loop.max_iterations,
    31	            num_available=loop.num_available, contr=loop.contr,
    32	            sigma_max=loop.wfm.sigma_max,
    33	            data_hash=hashlib.sha256(json.dumps(database, sort_keys=True).encode()).hexdigest(),
    34	        )
    35	
    36	    def restore(self):
    37	        loop = self.loop
    38	        pointer = self.root / 'latest.json'
    39	        state = None
    40	        if pointer.exists():
    41	            meta = json.loads(pointer.read_text())
    42	            state = torch.load(self.root / meta['file'], map_location='cpu', weights_only=False)
    43	            if state['identity'] != self.identity or state['step'] != meta['step']:
    44	                raise ValueError('Recovery state does not match this experiment')
    45	            loop.model.load_state_dict(state['model'])
    46	            loop.source_model.load_state_dict(state['source'])
    47	            loop.opt.load_state_dict(state['optimizer'])
    48	            loop.resume_step = state['step']
    49	            loop.step = 1
    50	            self.consumed = state['consumed']
    51	            self.previous_elapsed = state['elapsed_seconds']
    52	            loop._last_model_input_shape = state['model_input_shape']
    53	            loop.datal.batch_sampler.resume_epoch = (state['epoch_batches'], self.consumed)
    54	        for temporary in self.root.glob('*.tmp'):
    55	            temporary.unlink()
    56	        self._trim_records(loop.resume_step)
    57	        loop.iterdatal = iter(loop.datal)
    58	        if state is not None:
    59	            # Iterator creation consumes torch RNG. Restore training RNG afterwards.
    60	            random.setstate(state['python_rng'])
    61	            np.random.set_state(state['numpy_rng'])
    62	            torch.set_rng_state(state['torch_rng'])
    63	            if state['cuda_rng']:
    64	                torch.cuda.set_rng_state_all(state['cuda_rng'])
    65	            loop.available_rng.setstate(state['available_rng'])
    66	        return loop.resume_step
    67	
    68	    def _trim_records(self, step):
    69	        for name in ('batch_targets.csv', 'progress.csv', 'source_weights_train.csv'):
    70	            path = self.directory / name
    71	            if not path.exists():
    72	                continue
    73	            with path.open() as stream:
    74	                reader = csv.DictReader(stream)
    75	                fields = reader.fieldnames
    76	                rows = [r for r in reader if r.get('step', '').isdigit() and int(r['step']) <= step]
    77	            if not fields:
    78	                path.unlink()
    79	                continue
    80	            temporary = path.with_suffix('.csv.tmp')
    81	            with temporary.open('w', newline='') as stream:
    82	                writer = csv.DictWriter(stream, fieldnames=fields)
