    83	                    "--sigma_max", str(job["sigma"]), "--num_available", "3", "--metrics_only", "True"]
    84	        (out / "commands.json").write_text(json.dumps(dict(train=train_cmd, evaluation=eval_cmd), indent=2) + "\n")
    85	        with (out / "eval-valfull.log").open("w") as log:
    86	            subprocess.run(eval_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
    87	        rows = json.loads((out / "eval-valfull-euler1-avail3-10000/metrics.json").read_text())
