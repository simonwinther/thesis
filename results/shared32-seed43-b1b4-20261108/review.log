     8	from evaluate import (
     9	    compute_metrics_masked, compute_psnr, compute_ssim, compute_mse, compute_mae,
    10	)
    11	
    12	
    13	def normalized_array(array):
    14	    # Match evaluate.load_nifti, including float32 and clipping before metrics.
    15	    return np.clip(np.nan_to_num(array.astype(np.float64), nan=0.0), 0, None).astype(np.float32)
    16	
    17	
    18	class StreamingMetrics:
    19	    def __init__(self):
    20	        self.rows = {}
    21	
    22	    def add(self, subject, modality, prediction, target):
    23	        pred, gt = normalized_array(prediction), normalized_array(target)
    24	        if pred.shape != gt.shape or not np.isfinite(pred).all() or not np.isfinite(gt).all():
    25	            raise ValueError(f"Invalid prediction/target for {subject}/{modality}")
    26	        masked = compute_metrics_masked(pred, gt)
    27	        full = dict(psnr=compute_psnr(pred, gt), ssim=compute_ssim(pred, gt),
    28	                    mse=compute_mse(pred, gt), mae=compute_mae(pred, gt))
    29	        self.rows.setdefault(modality, []).append(dict(
    30	            subject=subject, masked={k: float(v) for k, v in masked.items()},
    31	            full={k: float(v) for k, v in full.items()},
    32	        ))
    33	
    34	    def save(self, output_dir):
    35	        output_dir = Path(output_dir)
    36	        for modality, rows in self.rows.items():
    37	            for scope, prefix in (("masked", "metrics-"), ("full", "metrics-full-")):
    38	                means = {key: float(np.mean([r[scope][key] for r in rows]))
    39	                         for key in ("psnr", "ssim", "mse", "mae")}
    40	                lines = ["EVALUATION RESULTS", f"Contrast: {modality}",
    41	                         f"Number of samples: {len(rows)}",
    42	                         f"Prediction directory: {output_dir} (metrics only)"]
    43	                for key, digits in (("psnr", ".2f"), ("ssim", ".4f"), ("mse", ".2e"), ("mae", ".4f")):
    44	                    sd = np.std([r[scope][key] for r in rows])
    45	                    lines.append(f"{key.upper()}: {means[key]:{digits}} +/- {sd:{digits}}")
    46	                lines.extend(["", "Per-sample results:"])
    47	                for r in rows:
    48	                    values = r[scope]
    49	                    lines.append(f"{r['subject']}: PSNR={values['psnr']:.2f}, "
    50	                                 f"SSIM={values['ssim']:.4f}, MSE={values['mse']:.2e}")
    51	                (output_dir / f"{prefix}{modality}.txt").write_text("\n".join(lines) + "\n")
    52	        # Preserve full precision for aggregation instead of rounded text means.
    53	        (output_dir / "metrics.json").write_text(json.dumps(self.rows, indent=2, allow_nan=False) + "\n")
