    16	def main():
    17	    plan = json.loads(Path(sys.argv[1]).read_text())
    18	    job = plan["jobs"][int(sys.argv[2])]
    19	    out = Path(job["directory"])
    20	    status = out / "status.txt"
    21	    preflight_only = '--preflight-only' in sys.argv[3:]
    22	    try:
    23	        if status.read_text().strip() != "queued":
    24	            raise RuntimeError("Refusing to rerun an entry that has already started")
    25	        if shutil.disk_usage(out).free < 30 * 1024**3:
    26	            raise RuntimeError("Less than 30 GiB free; refusing to fill shared storage")
    27	        manifest = json.loads((Path(plan["sweep"]) / "code_sha256.json").read_text())
    28	        for name, digest in manifest.items():
    29	            assert hashlib.sha256((Path(plan["code"]) / name).read_bytes()).hexdigest() == digest, name
    30	        if not preflight_only and not torch.cuda.is_available():
    31	            raise RuntimeError('Training requires a GPU allocation')
    32	        batch_size = int(plan.get('batch_size', 4))
    33	        mixed_targets = plan.get('mixed_targets', True)
    34	        use_checkpoint = plan.get('use_checkpoint', True)
    35	        if batch_size not in (1, 4) or mixed_targets != (batch_size == 4):
    36	            raise ValueError('Expected batch 1 with one target or batch 4 with four mixed targets')
    37	        runtime = dict(started_utc=datetime.now(timezone.utc).isoformat(),
    38	                       python=sys.version, torch=torch.__version__, cuda=torch.version.cuda,
    39	                       gpu=torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
    40	                       visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES"),
    41	                       slurm_job=os.environ.get("SLURM_JOB_ID"), job=job,
    42	                       batch_size=batch_size, mixed_targets=mixed_targets,
    43	                       use_checkpoint=use_checkpoint,
    44	                       cuda_allocator=os.environ.get('PYTORCH_CUDA_ALLOC_CONF', 'default'))
    45	        runtime["packages"] = {name: metadata.version(name) for name in
    46	                               ("numpy", "scipy", "scikit-image", "nibabel", "PyWavelets")}
    47	        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
    48	        # Paths from the established Mostafa layout. Verify case counts before training.
    49	        train = Path(plan['train_dir'])
    50	        val = Path(plan['val_dir'])
    51	        splits = {}
    52	        for name, directory, count in (("train", train, 1251), ("valfull", val, 219)):
    53	            cases = sorted(p.name for p in directory.iterdir() if p.is_dir() and p.name.startswith("BraTS-"))
    54	            assert len(cases) == count, (name, len(cases))
    55	            splits[name] = cases
    56	        assert not set(splits["train"]) & set(splits["valfull"])
    57	        (out / "split_manifest.json").write_text(json.dumps(splits, indent=2) + "\n")
    58	        if preflight_only:
    59	            (out / 'preflight_passed.json').write_text(json.dumps(runtime, indent=2) + '\n')
    60	            print('PASS: entrypoint manifests, packages, storage and full split checks')
    61	            return
    62	        flags = ["--source", job["arm"]] if job["arm"] in ("mean", "gaussian") else [
    63	            "--source", "learned", "--source_init", job["arm"]]
    64	        train_cmd = [sys.executable, "-u", "scripts/train_wfm.py", "--data_dir", str(train),
    65	                     "--contr", "all", "--batch_size", str(batch_size), "--mixed_targets", str(mixed_targets),
    66	                     "--use_checkpoint", str(use_checkpoint), "--num_workers", "4", "--lr", "1e-5", "--source_lr", "1e-3",
    67	                     "--sigma_max", str(job["sigma"]), "--seed", str(job["seed"]),
    68	                     "--max_iterations", "10000", "--save_interval", "10000", "--save_optimizer", "False",
    69	                     "--log_interval", "10", "--tensorboard_path", str(out), "--use_tensorboard", "False",
    70	                     "--source_architecture", "shared", "--source_shared_bias", "fixed", *flags]
    71	        if job['arm'] == 'biased':
    72	            raise RuntimeError('Biased is pending; it is not authorized in this sweep')
    73	        (out / 'commands.json').write_text(json.dumps(dict(train=train_cmd), indent=2) + '\n')
    74	        status.write_text("training\n")
    75	        with (out / "train.log").open("w") as log:
    76	            subprocess.run(train_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
    77	        subprocess.run([sys.executable, 'scripts/check_shared_pair.py', str(out), '10000', str(batch_size)], check=True)
    78	        status.write_text("evaluating-valfull\n")
    79	        eval_cmd = [sys.executable, "-u", "scripts/sample_wfm.py", "--model_path",
    80	                    str(out / "checkpoints/wfm_unified_010000.pt"), "--data_dir", str(val),
