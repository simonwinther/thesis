    12	def main():
    13	    parser = argparse.ArgumentParser()
    14	    parser.add_argument("remote_sweep")
    15	    parser.add_argument("destination", type=Path)
    16	    parser.add_argument("--once", action="store_true")
    17	    parser.add_argument("--host", default="mostafa", choices=("mostafa", "hendrix"))
    18	    args = parser.parse_args()
    19	    args.destination.mkdir(parents=True, exist_ok=True)
    20	    command = ["rsync", "-azm", "--stats", "--timeout=60", "--max-size=5m",
    21	               "--exclude=code/", "--exclude=checkpoints/", "--exclude=__pycache__/",
    22	               "--include=*/", "--include=*.txt", "--include=*.json", "--include=*.csv",
    23	               "--include=*.log", "--include=*.md", "--exclude=*",
    24	               "-e", "ssh -o BatchMode=yes -o ConnectTimeout=15",
    25	               f"{args.host}:{args.remote_sweep}/", str(args.destination) + "/"]
    26	    deadline = time.monotonic() + 14 * 86400
    27	    while time.monotonic() < deadline:
    28	        try:
    29	            preview = subprocess.run(command[:1] + ["--dry-run"] + command[1:], check=True,
    30	                                     capture_output=True, text=True, timeout=120, env={**os.environ, "LC_ALL": "C"})
    31	            match = re.search(r"Total transferred file size: ([\d,]+) bytes", preview.stdout)
    32	            if not match:
    33	                raise RuntimeError("Transfer size unavailable")
    34	            size = int(match[1].replace(",", ""))
    35	            if size > 250 * 1024**2:
    36	                raise RuntimeError(f"Refusing result transfer of {size} bytes")
    37	            subprocess.run(command, check=True, capture_output=True, timeout=180)
    38	            status_path = args.destination / "status.txt"
    39	            status = status_path.read_text().strip() if status_path.exists() else "unknown"
    40	            print(datetime.now(timezone.utc).isoformat(), f"copied {size} bytes; sweep={status}", flush=True)
    41	            if status in ("complete", "finished-with-errors", "cancelled") or args.once:
    42	                (args.destination / "backup_status.txt").write_text(f"copied; sweep={status}\n")
    43	                return
    44	        except (subprocess.SubprocessError, RuntimeError) as error:
    45	            print(datetime.now(timezone.utc).isoformat(), f"backup retry: {error}", flush=True)
    46	            if args.once:
    47	                raise
    48	        time.sleep(600)
    49	    (args.destination / "backup_status.txt").write_text("stopped after 14 days; verify remaining results\n")
    50	
    51	
    52	if __name__ == "__main__":
    53	    main()
