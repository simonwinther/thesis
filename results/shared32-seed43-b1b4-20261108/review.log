    55	            (root / 'backup_status.txt').write_text('complete: all eight results copied and report validated\n')
    56	            return
    57	        if successful and len(states) == 2 and all(s in ('complete', 'cancelled', 'finished-with-errors') for s in states.values()):
    58	            (root / 'backup_status.txt').write_text('stopped: all available small results copied; check failed/cancelled runs\n')
    59	            return
    60	        time.sleep(600)
    61	    (root / 'backup_status.txt').write_text('monitor stopped after 14 days; check remaining runs\n')
