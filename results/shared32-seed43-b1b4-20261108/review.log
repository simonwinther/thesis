    38	        groups[int(row['step'])].append(row)
    39	    assert set(groups) == set(range(1, updates + 1))
    40	    for batch in groups.values():
    41	        assert len(batch) == 4
    42	        assert {r['target'] for r in batch} == set(ALL_MODALITIES)
    43	        assert {int(r['sample']) for r in batch} == {0, 1, 2, 3}
    44	        assert len({r['subject'] for r in batch}) == 4
    45	        for r in batch:
    46	            assert {r[f'condition_{i}'] for i in (1, 2, 3)} == set(ALL_MODALITIES) - {r['target']}
    47	    summary = json.loads((directory / 'training_summary.json').read_text())
    48	    assert summary['batch_size'] == 4 and summary['mixed_targets'] is True
    49	    assert summary['optimizer_updates'] == updates
    50	    assert summary['training_examples'] == updates * 4
    51	    assert not list((directory / 'checkpoints').glob('opt_*.pt'))
    52	    checkpoint = directory / 'checkpoints' / f'source_unified_{updates:06d}.pt'
    53	    source = load_source(checkpoint)
    54	    if source.mode == 'learned':
    55	        assert source.architecture == 'shared' and source.shared_bias == 'fixed'
    56	        assert sum(p.numel() for p in source.parameters()) == 32
    57	        initial = StartingSource(**source.config())
    58	        assert (source.table_logits - initial.table_logits).abs().max() > 0
    59	    else:
    60	        assert len(list(source.parameters())) == 0
    61	    print('PASS: actual training audit has four distinct patients/targets at every optimizer update.')
