    26	            directory = root / host / 'runs' / Path(job['directory']).name
    27	            assert (directory / 'status.txt').read_text().strip() == 'complete'
    28	            summary = json.loads((directory / 'training_summary.json').read_text())
    29	            assert summary['batch_size'] == batch and summary['mixed_targets'] == (batch == 4)
    30	            assert summary['optimizer_updates'] == 10000 and summary['training_examples'] == 10000 * batch
    31	            cases = set(json.loads((directory / 'split_manifest.json').read_text())['valfull'])
    32	            assert len(cases) == 219
    33	            if expected_cases is None:
