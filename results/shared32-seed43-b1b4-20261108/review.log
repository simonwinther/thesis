=== experiment_manifest.py
     1	"""Small, deterministic manifests for reviewed and smoke-tested source code."""
     2	import hashlib
     3	from pathlib import Path
     4	
     5	EXCLUDED = {'runs', 'results', 'datasets', 'assets', '.git', '__pycache__', '.venv', 'venv', 'envs', '.cache'}
     6	RUNTIME_SCRIPTS = {'train_wfm.py', 'sample_wfm.py', 'stream_metrics.py', 'evaluate.py',
     7	                   'check_mixed_batch.py', 'check_shared_pair.py', 'experiment_manifest.py'}
     8	
     9	
    10	def code_manifest(root):
    11	    root = Path(root)
    12	    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
    13	            for p in sorted(root.rglob('*'))
    14	            if p.is_file() and p.suffix in ('.py', '.sh', '.sbatch')
    15	            and not set(p.relative_to(root).parts) & EXCLUDED}
    16	
    17	
    18	def training_manifest(root):
    19	    return {name: digest for name, digest in code_manifest(root).items()
    20	            if name.startswith(('DWT_IDWT/', 'guided_diffusion/'))
    21	            or name in ('scripts/slurm/check_mixed.sbatch', 'scripts/slurm/check_shared_pair.sbatch', 'scripts/slurm/env.sh')
    22	            or (name.startswith('scripts/') and Path(name).name in RUNTIME_SCRIPTS)}
=== slurm_queue.py
     1	"""Keep transient Slurm teardown states from causing an unnecessary relaunch."""
     2	import getpass
     3	import subprocess
     4	import time
     5	
     6	
     7	def wait_for_queue_room(additional=9, limit=10, timeout=180):
     8	    deadline = time.monotonic() + timeout
     9	    while True:
    10	        queued = subprocess.check_output(
    11	            ['squeue', '-h', '-r', '-u', getpass.getuser(), '-o', '%A'], text=True).splitlines()
    12	        if len(queued) + additional <= limit:
    13	            return
    14	        if time.monotonic() >= deadline:
    15	            raise RuntimeError(f'Submitting would exceed {limit} queued/running jobs; no jobs submitted')
    16	        time.sleep(5)
