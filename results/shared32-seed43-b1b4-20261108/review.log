    37	                successful = False
    38	                host_rows = [dict(host=host, seed=43, batch_size=config['batch_size'], source=job['arm'],
    39	                                  sigma=job['sigma'], slurm_task='pending', status='awaiting-submission',
    40	                                  remote_directory=job['directory'],
    41	                                  local_results=str(local / 'runs' / Path(job['directory']).name))
    42	                             for job in config['expected_jobs']]
    43	            rows.extend(host_rows)
    44	        if rows:
    45	            with (root / 'RUN_LOCATIONS.csv').open('w', newline='') as stream:
    46	                writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
    47	                writer.writeheader()
    48	                writer.writerows(rows)
    49	        progress = dict(updated_utc=datetime.now(timezone.utc).isoformat(), hosts=states,
    50	                        runs=dict(Counter(row['status'] for row in rows)))
    51	        (root / 'progress.json').write_text(json.dumps(progress, indent=2) + '\n')
    52	        print(json.dumps(progress), flush=True)
    53	        if successful and len(rows) == 8 and all(row['status'] == 'complete' for row in rows):
