     1	"""Check the shared table against explicit sums, masking, and gradient updates."""
     2	
     3	import itertools
     4	from pathlib import Path
     5	import sys
     6	import tempfile
     7	
     8	import numpy as np
     9	import torch as th
    10	
    11	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    12	from guided_diffusion.source import ALL_MODALITIES, BIASED_PARTNER, StartingSource, load_source, save_source
    13	from stream_metrics import StreamingMetrics, normalized_array
    14	from evaluate import load_nifti, compute_metrics_masked
    15	import nibabel as nib
    16	
    17	
    18	def main():
    19	    state = th.get_rng_state()
    20	    for init in ("uniform", "random", "biased"):
    21	        source = StartingSource("learned", init, architecture="shared")
    22	        assert sum(p.numel() for p in source.parameters()) == 32
    23	        assert th.equal(state, th.get_rng_state()), "Initialization changed the training RNG"
    24	    source = StartingSource("learned", "random", architecture="shared")
    25	    assert th.equal(source.table_logits, StartingSource("learned", "random", architecture="shared").table_logits)
    26	    assert not th.equal(source.table_logits, StartingSource("learned", "random", seed=43, architecture="shared").table_logits)
    27	
    28	    # Distinct values expose transposed bands, modality mixups and summing bands.
    29	    generator = th.Generator().manual_seed(123)
    30	    coefficients = th.randn(2, 4, 8, 3, 3, 3, generator=generator)
    31	    with th.no_grad():
    32	        source.table_logits.copy_(th.arange(32).reshape(8, 4) / 17)
    33	    for target in ALL_MODALITIES:
    34	        names = [m for m in ALL_MODALITIES if m != target]
    35	        ids = [ALL_MODALITIES.index(m) for m in names]
    36	        cond = coefficients[:, ids].flatten(1, 2)
    37	        for mask in itertools.product((False, True), repeat=3):
    38	            if not any(mask):
    39	                continue
    40	            available = th.tensor([mask, mask[::-1]])
    41	            result, weights = source(cond, names, target, available)
    42	            assert result.shape == (2, 8, 3, 3, 3)
    43	            for batch in range(2):
    44	                for band in range(8):
    45	                    raw = [source.table_logits[band, i].exp() if available[batch, j] else th.tensor(0.)
    46	                           for j, i in enumerate(ids)]
    47	                    expected_weights = th.stack(raw) / sum(raw)
    48	                    expected = sum(expected_weights[j] * coefficients[batch, i, band]
    49	                                   for j, i in enumerate(ids))
    50	                    th.testing.assert_close(result[batch, band], expected)
    51	                    th.testing.assert_close(weights[batch, :, band], expected_weights)
    52	            altered = cond * 7 + 23
    53	            assert th.equal(weights, source(altered, names, target, available)[1])
    54	
    55	        uniform = StartingSource("learned", architecture="shared")
    56	        available = th.ones(2, 3, dtype=th.bool)
    57	        th.testing.assert_close(uniform(cond, names, target, available)[0], coefficients[:, ids].mean(1))
    58	        biased = StartingSource("learned", "biased", architecture="shared")
    59	        weights = biased(cond, names, target, available)[1]
    60	        for j, name in enumerate(names):
    61	            expected = 1/3 if target == "t1n" else (0.6 if name == "t1n" else 0.2)
    62	            th.testing.assert_close(weights[:, j], th.full((2, 8), expected))
    63	        partner_bias = StartingSource("learned", "biased", architecture="shared", shared_bias="partner")
    64	        assert sum(p.numel() for p in partner_bias.parameters()) == 32
    65	        weights = partner_bias(cond, names, target, available)[1]
    66	        for j, name in enumerate(names):
    67	            expected = 0.6 if name == BIASED_PARTNER[target] else 0.2
    68	            th.testing.assert_close(weights[:, j], th.full((2, 8), expected))
    69	
    70	    # Accumulate four different held-out targets into exactly the SAME table.
    71	    trainable = StartingSource("learned", architecture="shared")
    72	    optimizer = th.optim.AdamW(trainable.parameters(), lr=1e-3)
    73	    loss = 0
    74	    for target_idx, target in enumerate(ALL_MODALITIES):
    75	        names = [m for m in ALL_MODALITIES if m != target]
    76	        ids = [ALL_MODALITIES.index(m) for m in names]
    77	        start, _ = trainable(coefficients[:, ids].flatten(1, 2), names, target,
    78	                             th.ones(2, 3, dtype=th.bool))
    79	        target_coeff = coefficients[:, target_idx]
    80	        path = 0.7 * start + 0.3 * target_coeff
    81	        velocity_target = target_coeff - start
    82	        loss = loss + (path.square() - velocity_target).square().mean()
    83	    loss.backward()
    84	    assert th.isfinite(trainable.table_logits.grad).all()
    85	    assert (trainable.table_logits.grad.abs() > 0).all()
    86	    optimizer.step()
    87	    assert (trainable.table_logits != 0).any()
    88	    with tempfile.TemporaryDirectory() as folder:
    89	        checkpoint = Path(folder) / "source.pt"
    90	        save_source(trainable, checkpoint)
    91	        restored = load_source(checkpoint)
    92	        assert restored.config() == trainable.config()
    93	        assert th.equal(restored.table_logits, trainable.table_logits)
    94	        # A real NIfTI round trip must give the same numbers as streaming.
    95	        rng = np.random.default_rng(42)
    96	        pred = rng.uniform(-0.1, 1, (16, 16, 16)).astype(np.float32)
    97	        gt = rng.uniform(0, 1, pred.shape).astype(np.float32)
    98	        gt[:3] = 0
    99	        paths = [Path(folder) / name for name in ("pred.nii.gz", "gt.nii.gz")]
   100	        for path, array in zip(paths, (pred, gt)):
   101	            nib.save(nib.Nifti1Image(array, np.eye(4)), path)
   102	            np.testing.assert_array_equal(load_nifti(path), normalized_array(array))
   103	        expected = compute_metrics_masked(*(load_nifti(p) for p in paths))
   104	        metrics = StreamingMetrics()
   105	        metrics.add("case", "t1n", pred, gt)
   106	        for key, value in expected.items():
   107	            assert metrics.rows["t1n"][0]["masked"][key] == value
   108	        metrics.save(folder)
   109	    if len(sys.argv) > 1:
   110	        old = load_source(sys.argv[1])
   111	        assert old.architecture == "conditional"
   112	        assert "architecture" not in old.config()
   113	    print("PASS: 32 parameters, all targets/subsets, explicit weighted sums, RNG isolation, "
   114	          "uniform/biased/random initialization, shared gradients, checkpoint round trip, "
   115	          "NIfTI/streaming metric equivalence and historical checkpoint loading.")
