    80	        assert names[row] == expected_names
    81	        for slot, modality in enumerate(expected_names):
    82	            th.testing.assert_close(cond_imgs[slot][row], images[modality][row])
    83	            th.testing.assert_close(coeff[row, slot*8:(slot+1)*8], apply_dwt(images[modality][row:row+1])[0])
    84	
    85	    # Poison each row's held-out image; its source and conditions must not change.
