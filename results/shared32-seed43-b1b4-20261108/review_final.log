   137	def main():
   138	    plan = json.loads(Path(sys.argv[1]).read_text())
   139	    job = plan["jobs"][int(sys.argv[2])]
   140	    out = Path(job["directory"])
   141	    status = out / "status.txt"
   142	    preflight_only = '--preflight-only' in sys.argv[3:]
   143	    try:
   144	        if status.read_text().strip() != "queued":
   145	            raise RuntimeError("Refusing to rerun an entry that has already started")
   146	        if shutil.disk_usage(out).free < 30 * 1024**3:
   147	            raise RuntimeError("Less than 30 GiB free; refusing to fill shared storage")
   148	        manifest = json.loads((Path(plan["sweep"]) / "code_sha256.json").read_text())
   149	        for name, digest in manifest.items():
   150	            assert hashlib.sha256((Path(plan["code"]) / name).read_bytes()).hexdigest() == digest, name
   151	        if not preflight_only and not torch.cuda.is_available():
   152	            raise RuntimeError('Training requires a GPU allocation')
   153	        batch_size = int(plan.get('batch_size', 4))
   154	        mixed_targets = plan.get('mixed_targets', True)
   155	        use_checkpoint = plan.get('use_checkpoint', True)
   156	        if batch_size not in (1, 4) or mixed_targets != (batch_size == 4):
   157	            raise ValueError('Expected batch 1 with one target or batch 4 with four mixed targets')
   158	        runtime = dict(started_utc=datetime.now(timezone.utc).isoformat(),
   159	                       python=sys.version, torch=torch.__version__, cuda=torch.version.cuda,
   160	                       gpu=torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
   161	                       visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES"),
   162	                       slurm_job=os.environ.get("SLURM_JOB_ID"), job=job,
   163	                       batch_size=batch_size, mixed_targets=mixed_targets,
   164	                       use_checkpoint=use_checkpoint,
   165	                       cuda_allocator=os.environ.get('PYTORCH_CUDA_ALLOC_CONF', 'default'))
   166	        expected_allocator = 'max_split_size_mb:128' if batch_size == 4 else 'default'
   167	        if runtime['cuda_allocator'] != expected_allocator:
   168	            raise RuntimeError('CUDA allocator differs from the approved GPU check')
   169	        runtime["packages"] = {name: metadata.version(name) for name in
   170	                               ("numpy", "scipy", "scikit-image", "nibabel", "PyWavelets")}
   171	        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
   172	        # Paths from the established Mostafa layout. Verify case counts before training.
   173	        train = Path(plan['train_dir'])
   174	        val = Path(plan['val_dir'])
   175	        splits = {}
   176	        for name, directory, count in (("train", train, 1251), ("valfull", val, 219)):
   177	            cases = sorted(p.name for p in directory.iterdir() if p.is_dir() and p.name.startswith("BraTS-"))
   178	            assert len(cases) == count, (name, len(cases))
   179	            splits[name] = cases
   180	        assert not set(splits["train"]) & set(splits["valfull"])
   181	        (out / "split_manifest.json").write_text(json.dumps(splits, indent=2) + "\n")
   182	        if preflight_only:
   183	            (out / 'preflight_passed.json').write_text(json.dumps(runtime, indent=2) + '\n')
   184	            print('PASS: entrypoint manifests, packages, storage and full split checks')
   185	            return
   186	        flags = ["--source", job["arm"]] if job["arm"] in ("mean", "gaussian") else [
   187	            "--source", "learned", "--source_init", job["arm"]]
   188	        train_cmd = [sys.executable, "-u", "scripts/train_wfm.py", "--data_dir", str(train),
   189	                     "--contr", "all", "--batch_size", str(batch_size), "--mixed_targets", str(mixed_targets),
   190	                     "--use_checkpoint", str(use_checkpoint), "--num_workers", "4", "--lr", "1e-5", "--source_lr", "1e-3",
   191	                     "--sigma_max", str(job["sigma"]), "--seed", str(job["seed"]),
   192	                     "--max_iterations", "10000", "--save_interval", "10000", "--save_optimizer", "False",
   193	                     "--log_interval", "10", "--tensorboard_path", str(out), "--use_tensorboard", "False",
   194	                     "--source_architecture", "shared", "--source_shared_bias", "fixed", *flags]
   195	        if job['arm'] == 'biased':
   196	            raise RuntimeError('Biased is pending; it is not authorized in this sweep')
   197	        (out / 'commands.json').write_text(json.dumps(dict(train=train_cmd), indent=2) + '\n')
   198	        status.write_text("training\n")
   199	        with (out / "train.log").open("w") as log:
   200	            subprocess.run(train_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
   201	        subprocess.run([sys.executable, 'scripts/check_shared_pair.py', str(out), '10000', str(batch_size)], check=True)
   202	        status.write_text("evaluating-valfull\n")
   203	        eval_cmd = [sys.executable, "-u", "scripts/sample_wfm.py", "--model_path",
   204	                    str(out / "checkpoints/wfm_unified_010000.pt"), "--data_dir", str(val),
   205	                    "--output_dir", str(out / "eval-valfull-euler1-avail3-10000"),
   206	                    "--contr", "all", "--sampling_steps", "1", "--num_samples", "-1", "--seed", "42",
   207	                    "--sigma_max", str(job["sigma"]), "--num_available", "3", "--metrics_only", "True"]
   208	        (out / "commands.json").write_text(json.dumps(dict(train=train_cmd, evaluation=eval_cmd), indent=2) + "\n")
   209	        with (out / "eval-valfull.log").open("w") as log:
   210	            subprocess.run(eval_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
   211	        rows = json.loads((out / "eval-valfull-euler1-avail3-10000/metrics.json").read_text())
   212	        assert set(rows) == {"t1n", "t1c", "t2w", "t2f"}
   213	        for modality, values in rows.items():
   214	            assert len(values) == 219 and {r["subject"] for r in values} == set(splits["valfull"]), modality
   215	        runtime["finished_utc"] = datetime.now(timezone.utc).isoformat()
   216	        runtime['host'] = plan['host']
   217	        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
   218	        status.write_text("complete\n")
   219	    except BaseException as error:
   220	        status.write_text(f"failed: {type(error).__name__}: {error}\n")
   221	        raise
