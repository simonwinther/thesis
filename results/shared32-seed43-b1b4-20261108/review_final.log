    49	"""Report the seed-43 batch-size comparison without pooling unlike runs."""
    50	
    51	import csv
    52	import json
    53	import math
    54	from pathlib import Path
    55	import re
    56	import statistics
    57	import sys
    58	
    59	MODALITIES = ('t1n', 't1c', 't2w', 't2f')
    60	
    61	
    62	def main():
    63	    registry_path = Path(sys.argv[1]).resolve()
    64	    root = registry_path.parent
    65	    registry = json.loads(registry_path.read_text())
    66	    records = []
    67	    expected_cases = None
    68	    for host, batch in (('mostafa', 1), ('hendrix', 4)):
    69	        plan = json.loads((root / host / 'run_plan.json').read_text())
    70	        assert len(plan['jobs']) == 4 and plan['batch_size'] == batch
    71	        assert {(j['arm'], j['sigma'], j['seed']) for j in plan['jobs']} == {
    72	            (arm, sigma, 43) for arm in ('uniform', 'random') for sigma in (0., .5)}
    73	        for job in plan['jobs']:
    74	            directory = root / host / 'runs' / Path(job['directory']).name
    75	            assert (directory / 'status.txt').read_text().strip() == 'complete'
    76	            summary = json.loads((directory / 'training_summary.json').read_text())
    77	            assert summary['batch_size'] == batch and summary['mixed_targets'] == (batch == 4)
    78	            assert summary['optimizer_updates'] == 10000 and summary['training_examples'] == 10000 * batch
    79	            cases = set(json.loads((directory / 'split_manifest.json').read_text())['valfull'])
    80	            assert len(cases) == 219
    81	            if expected_cases is None:
    82	                expected_cases = cases
    83	            assert cases == expected_cases
    84	            raw = json.loads((directory / 'eval-valfull-euler1-avail3-10000/metrics.json').read_text())
    85	            assert set(raw) == set(MODALITIES)
    86	            scores = {'ssim': [], 'psnr': []}
    87	            for modality in MODALITIES:
    88	                values = raw[modality]
    89	                assert len(values) == 219 and {r['subject'] for r in values} == cases
    90	                for key in scores:
    91	                    numbers = [r['masked'][key] for r in values]
    92	                    assert all(math.isfinite(n) for n in numbers)
    93	                    scores[key].append(statistics.mean(numbers))
    94	            records.append(dict(host=host, batch_size=batch, seed=43, sigma=job['sigma'],
    95	                                source=job['arm'], **{k: statistics.mean(v) for k, v in scores.items()}))
    96	    baselines = []
    97	    assert len(registry['historical_baselines']) == 4
    98	    assert {(r['source'], r['sigma'], r['seed'], r['batch_size']) for r in registry['historical_baselines']} == {
    99	        (source, sigma, 43, 1) for source in ('mean', 'gaussian') for sigma in (0., .5)}
   100	    for item in registry['historical_baselines']:
   101	        directory = Path(item['directory'])
   102	        scores = {'ssim': [], 'psnr': []}
   103	        for modality in MODALITIES:
   104	            text = (directory / 'eval-valfull-euler1-avail3-10000' / f'metrics-{modality}.txt').read_text()
   105	            assert re.search(rf'^Contrast:\s*{modality}\s*$', text, re.M)
   106	            assert re.search(r'^Number of samples:\s*219\s*$', text, re.M)
   107	            ids = re.findall(r'^(BraTS-[^:\n]+): PSNR=', text, re.M)
   108	            assert len(ids) == 219 and set(ids) == expected_cases
   109	            for key in scores:
   110	                value = float(re.search(rf'^{key.upper()}:\s*([\d.eE+-]+)', text, re.M)[1])
   111	                assert math.isfinite(value)
   112	                scores[key].append(value)
   113	        baselines.append(dict(source=item['source'], sigma=item['sigma'], batch_size=1,
   114	                              **{k: statistics.mean(v) for k, v in scores.items()}))
   115	    with (root / 'scores.csv').open('w', newline='') as stream:
   116	        writer = csv.DictWriter(stream, fieldnames=list(records[0]))
