   242	"""Small, deterministic manifests for reviewed and smoke-tested source code."""
   243	import hashlib
   244	from pathlib import Path
   245	
   246	EXCLUDED = {'runs', 'results', 'datasets', 'assets', '.git', '__pycache__', '.venv', 'venv', 'envs', '.cache'}
   247	RUNTIME_SCRIPTS = {'train_wfm.py', 'sample_wfm.py', 'stream_metrics.py', 'evaluate.py',
