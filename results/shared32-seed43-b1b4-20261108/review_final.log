   251	def code_manifest(root):
   252	    root = Path(root)
   253	    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
   254	            for p in sorted(root.rglob('*'))
   255	            if p.is_file() and p.suffix in ('.py', '.sh', '.sbatch')
   256	            and not set(p.relative_to(root).parts) & EXCLUDED}
   257	
   258	
   259	def training_manifest(root):
   260	    return {name: digest for name, digest in code_manifest(root).items()
   261	            if name.startswith(('DWT_IDWT/', 'guided_diffusion/'))
   262	            or name in ('scripts/slurm/check_mixed.sbatch', 'scripts/slurm/check_shared_pair.sbatch', 'scripts/slurm/env.sh')
   263	            or (name.startswith('scripts/') and Path(name).name in RUNTIME_SCRIPTS)}
