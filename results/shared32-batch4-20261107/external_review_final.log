     1	"""Execute one immutable sweep entry; keep small results and final weights."""
     2	
     3	from datetime import datetime, timezone
     4	import hashlib
     5	from importlib import metadata
     6	import json
     7	import os
     8	from pathlib import Path
     9	import shutil
    10	import subprocess
    11	import sys
    12	
    13	import torch
    14	
    15	
    16	def main():
    17	    plan = json.loads(Path(sys.argv[1]).read_text())
    18	    job = plan["jobs"][int(sys.argv[2])]
    19	    out = Path(job["directory"])
    20	    status = out / "status.txt"
    21	    preflight_only = '--preflight-only' in sys.argv[3:]
    22	    try:
    23	        if status.read_text().strip() != "queued":
    24	            raise RuntimeError("Refusing to rerun an entry that has already started")
    25	        if shutil.disk_usage(out).free < 30 * 1024**3:
    26	            raise RuntimeError("Less than 30 GiB free; refusing to fill shared storage")
    27	        manifest = json.loads((Path(plan["sweep"]) / "code_sha256.json").read_text())
    28	        for name, digest in manifest.items():
    29	            assert hashlib.sha256((Path(plan["code"]) / name).read_bytes()).hexdigest() == digest, name
    30	        if not preflight_only and not torch.cuda.is_available():
    31	            raise RuntimeError('Training requires a GPU allocation')
    32	        runtime = dict(started_utc=datetime.now(timezone.utc).isoformat(),
    33	                       python=sys.version, torch=torch.__version__, cuda=torch.version.cuda,
    34	                       gpu=torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
    35	                       visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES"),
    36	                       slurm_job=os.environ.get("SLURM_JOB_ID"), job=job)
    37	        runtime["packages"] = {name: metadata.version(name) for name in
    38	                               ("numpy", "scipy", "scikit-image", "nibabel", "PyWavelets")}
    39	        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
    40	        # Paths from the established Mostafa layout. Verify case counts before training.
    41	        train = Path(plan['train_dir'])
    42	        val = Path(plan['val_dir'])
    43	        splits = {}
    44	        for name, directory, count in (("train", train, 1251), ("valfull", val, 219)):
    45	            cases = sorted(p.name for p in directory.iterdir() if p.is_dir() and p.name.startswith("BraTS-"))
    46	            assert len(cases) == count, (name, len(cases))
    47	            splits[name] = cases
    48	        assert not set(splits["train"]) & set(splits["valfull"])
    49	        (out / "split_manifest.json").write_text(json.dumps(splits, indent=2) + "\n")
    50	        if preflight_only:
    51	            (out / 'preflight_passed.json').write_text(json.dumps(runtime, indent=2) + '\n')
    52	            print('PASS: entrypoint manifests, packages, storage and full split checks')
    53	            return
    54	        flags = ["--source", job["arm"]] if job["arm"] in ("mean", "gaussian") else [
    55	            "--source", "learned", "--source_init", job["arm"]]
    56	        train_cmd = [sys.executable, "-u", "scripts/train_wfm.py", "--data_dir", str(train),
    57	                     "--contr", "all", "--batch_size", "4", "--mixed_targets", "True",
    58	                     "--use_checkpoint", "True", "--num_workers", "4", "--lr", "1e-5", "--source_lr", "1e-3",
    59	                     "--sigma_max", str(job["sigma"]), "--seed", str(job["seed"]),
    60	                     "--max_iterations", "10000", "--save_interval", "10000", "--save_optimizer", "False",
    61	                     "--log_interval", "10", "--tensorboard_path", str(out), "--use_tensorboard", "False",
    62	                     "--source_architecture", "shared", "--source_shared_bias", "fixed", *flags]
    63	        if job['arm'] == 'biased':
    64	            raise RuntimeError('Biased is pending; it is not authorized in this sweep')
    65	        (out / 'commands.json').write_text(json.dumps(dict(train=train_cmd), indent=2) + '\n')
    66	        status.write_text("training\n")
    67	        with (out / "train.log").open("w") as log:
    68	            subprocess.run(train_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
    69	        subprocess.run([sys.executable, 'scripts/check_mixed_batch.py', str(out), '10000'], check=True)
    70	        status.write_text("evaluating-valfull\n")
    71	        eval_cmd = [sys.executable, "-u", "scripts/sample_wfm.py", "--model_path",
    72	                    str(out / "checkpoints/wfm_unified_010000.pt"), "--data_dir", str(val),
    73	                    "--output_dir", str(out / "eval-valfull-euler1-avail3-10000"),
    74	                    "--contr", "all", "--sampling_steps", "1", "--num_samples", "-1", "--seed", "42",
    75	                    "--sigma_max", str(job["sigma"]), "--num_available", "3", "--metrics_only", "True"]
    76	        (out / "commands.json").write_text(json.dumps(dict(train=train_cmd, evaluation=eval_cmd), indent=2) + "\n")
    77	        with (out / "eval-valfull.log").open("w") as log:
    78	            subprocess.run(eval_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
    79	        rows = json.loads((out / "eval-valfull-euler1-avail3-10000/metrics.json").read_text())
    80	        assert set(rows) == {"t1n", "t1c", "t2w", "t2f"}
    81	        for modality, values in rows.items():
    82	            assert len(values) == 219 and {r["subject"] for r in values} == set(splits["valfull"]), modality
    83	        runtime["finished_utc"] = datetime.now(timezone.utc).isoformat()
    84	        runtime['host'] = plan['host']
    85	        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
    86	        status.write_text("complete\n")
    87	    except BaseException as error:
    88	        status.write_text(f"failed: {type(error).__name__}: {error}\n")
    89	        raise
    90	
    91	
    92	if __name__ == "__main__":
    93	    main()
=== scripts/submit_shared_remaining.py
     1	"""Queue the second Hendrix wave only after its first eight runs have finished."""
     2	import json
     3	import getpass
     4	from pathlib import Path
     5	import subprocess
     6	import sys
     7	
     8	path = Path(sys.argv[1])
     9	plan = json.loads(path.read_text())
    10	root = Path(plan['sweep'])
    11	bad = [job for job in plan['jobs'][:8]
    12	       if (Path(job['directory']) / 'status.txt').read_text().strip() != 'complete']
    13	if bad:
    14	    (root / 'status.txt').write_text('finished-with-errors\n')
    15	    raise RuntimeError('First Hendrix wave did not complete; next wave remains unsubmitted')
    16	if 'second_array_job_id' in plan:
    17	    raise RuntimeError('Second wave was already submitted')
    18	queued = subprocess.check_output(['squeue', '-h', '-r', '-u', getpass.getuser(), '-o', '%A'], text=True).splitlines()
    19	if len(queued) + 9 > 10:
    20	    (root / 'status.txt').write_text('finished-with-errors\n')
    21	    raise RuntimeError('Hendrix would exceed ten queued/running jobs; second wave was not submitted')
    22	array = subprocess.check_output([
    23	    'sbatch', '--parsable', '--job-name=' + plan['name'], '--array=8-15', '--gpus=a100:1',
    24	    '--time=' + str(plan['time_limit_hours']) + ':00:00',
    25	    '--output=' + str(root / 'array-%A_%a.log'), '--chdir=' + plan['code'],
    26	    str(Path(plan['code']) / 'scripts/slurm/shared_arm.sbatch'), str(path),
    27	], text=True).strip()
    28	plan['second_array_job_id'] = array
    29	path.write_text(json.dumps(plan, indent=2) + '\n')
    30	report = subprocess.check_output([
    31	    'sbatch', '--parsable', '--partition=gpu', '--cpus-per-task=1', '--mem=2G', '--time=00:10:00',
    32	    '--job-name=' + plan['name'] + '-finish', '--dependency=afterany:' + array,
    33	    '--output=' + str(root / 'finish.log'), '--chdir=' + plan['code'],
    34	    str(Path(plan['code']) / 'scripts/slurm/shared_report.sbatch'), str(path),
    35	], text=True).strip()
    36	plan['report_job_id'] = report
    37	path.write_text(json.dumps(plan, indent=2) + '\n')
    38	print(json.dumps(dict(array_job_id=array, finish_job_id=report)))
=== scripts/finish_shared_host.py
     1	"""Validate completion of one host's assigned runs, without pooling partial seeds."""
     2	import json
     3	from pathlib import Path
     4	import sys
     5	
     6	plan = json.loads(Path(sys.argv[1]).read_text())
     7	states = {Path(job['directory']).name: (Path(job['directory']) / 'status.txt').read_text().strip()
     8	          for job in plan['jobs']}
     9	complete = all(state == 'complete' for state in states.values())
    10	root = Path(plan['sweep'])
    11	(root / 'completion.json').write_text(json.dumps(states, indent=2) + '\n')
    12	(root / 'status.txt').write_text('complete\n' if complete else 'finished-with-errors\n')
    13	if not complete:
    14	    raise RuntimeError('One or more assigned runs did not complete; see completion.json')
