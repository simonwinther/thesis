    10	out=${1:?Pass a new check directory}
    11	mkdir "$out"
    12	trap 'printf "failed\n" > "$out/status.txt"' ERR
    13	export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
    14	printf 'checking\n' > "$out/status.txt"
    15	CUDA_VISIBLE_DEVICES="" python scripts/check_mixed_batch.py
    16	for spec in uniform:0 random:0.5 mean:0 gaussian:0.5; do
    17	  arm=${spec%:*}
    18	  sigma=${spec#*:}
    19	  flags=(--source learned --source_init "$arm")
    20	  [[ $arm == mean || $arm == gaussian ]] && flags=(--source "$arm")
    21	  run="$out/$arm"
    22	  python -u scripts/train_wfm.py --data_dir "$TRAIN_DIR" --contr all --batch_size 4 \
    23	    --mixed_targets True --use_checkpoint True --num_workers 4 \
    24	    --lr 1e-5 --sigma_max "$sigma" --seed 42 --max_iterations 4 --save_interval 4 \
    25	    --log_interval 1 --tensorboard_path "$run" --source_architecture shared \
    26	    --source_shared_bias fixed --save_optimizer False --use_tensorboard False "${flags[@]}"
    27	  python scripts/check_mixed_batch.py "$run" 4
    28	  python -u scripts/sample_wfm.py --model_path "$run/checkpoints/wfm_unified_000004.pt" \
    29	    --data_dir "$VALFULL_DIR" --output_dir "$run/eval" --contr all --sampling_steps 1 \
    30	    --num_samples 1 --seed 42 --sigma_max "$sigma" --num_available 3 --metrics_only True
    31	done
    32	printf 'complete\n' > "$out/status.txt"
