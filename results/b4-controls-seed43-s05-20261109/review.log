"""Execute one immutable sweep entry; keep small results and final weights."""

from datetime import datetime, timezone
import hashlib
from importlib import metadata
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys

import torch


def main():
    plan = json.loads(Path(sys.argv[1]).read_text())
    job = plan["jobs"][int(sys.argv[2])]
    out = Path(job["directory"])
    status = out / "status.txt"
    preflight_only = '--preflight-only' in sys.argv[3:]
    if status.read_text().strip() != "queued":
        raise RuntimeError("Refusing to rerun an entry that has already started")
    try:
        if shutil.disk_usage(out).free < 30 * 1024**3:
            raise RuntimeError("Less than 30 GiB free; refusing to fill shared storage")
        manifest = json.loads((Path(plan["sweep"]) / "code_sha256.json").read_text())
        for name, digest in manifest.items():
            assert hashlib.sha256((Path(plan["code"]) / name).read_bytes()).hexdigest() == digest, name
        operation_manifest = json.loads((Path(plan["sweep"]) / "operations_sha256.json").read_text())
        for name, digest in operation_manifest.items():
            assert hashlib.sha256((Path(plan["sweep"]) / "operations" / name).read_bytes()).hexdigest() == digest, name
        if not preflight_only and not torch.cuda.is_available():
            raise RuntimeError('Training requires a GPU allocation')
        batch_size = int(plan.get('batch_size', 4))
        mixed_targets = plan.get('mixed_targets', True)
        use_checkpoint = plan.get('use_checkpoint', True)
        if batch_size not in (1, 4) or mixed_targets != (batch_size == 4):
            raise ValueError('Expected batch 1 with one target or batch 4 with four mixed targets')
        runtime = dict(started_utc=datetime.now(timezone.utc).isoformat(),
                       python=sys.version, torch=torch.__version__, cuda=torch.version.cuda,
                       gpu=torch.cuda.get_device_name(0) if not preflight_only and torch.cuda.is_available() else None,
                       visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES"),
                       slurm_job=os.environ.get("SLURM_JOB_ID"), job=job,
                       batch_size=batch_size, mixed_targets=mixed_targets,
                       use_checkpoint=use_checkpoint,
                       cuda_allocator=os.environ.get('PYTORCH_CUDA_ALLOC_CONF', 'default'))
        expected_allocator = 'max_split_size_mb:128' if batch_size == 4 else 'default'
        if runtime['cuda_allocator'] != expected_allocator:
            raise RuntimeError('CUDA allocator differs from the approved GPU check')
        runtime["packages"] = {name: metadata.version(name) for name in
                               ("numpy", "scipy", "scikit-image", "nibabel", "PyWavelets")}
        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
        # Paths from the established Mostafa layout. Verify case counts before training.
        train = Path(plan['train_dir'])
        val = Path(plan['val_dir'])
        splits = {}
        for name, directory, count in (("train", train, 1251), ("valfull", val, 219)):
            cases = sorted(p.name for p in directory.iterdir() if p.is_dir() and p.name.startswith("BraTS-"))
            assert len(cases) == count, (name, len(cases))
            splits[name] = cases
        assert not {x.rsplit("-", 1)[0] for x in splits["train"]} & {x.rsplit("-", 1)[0] for x in splits["valfull"]}
        (out / "split_manifest.json").write_text(json.dumps(splits, indent=2) + "\n")
        if preflight_only:
            subprocess.run([sys.executable, str(Path(plan["sweep"]) / "operations/numerical_check.py"), str(out / "numerical_validation.json")], check=True)
            (out / 'preflight_passed.json').write_text(json.dumps(runtime, indent=2) + '\n')
            print('PASS: entrypoint manifests, packages, storage and full split checks')
            return
        flags = ["--source", job["arm"]] if job["arm"] in ("mean", "gaussian") else [
            "--source", "learned", "--source_init", job["arm"]]
        train_cmd = [sys.executable, "-u", "scripts/train_wfm.py", "--data_dir", str(train),
                     "--contr", "all", "--batch_size", str(batch_size), "--mixed_targets", str(mixed_targets),
                     "--use_checkpoint", str(use_checkpoint), "--num_workers", "4", "--lr", "1e-5", "--source_lr", "1e-3",
                     "--sigma_max", str(job["sigma"]), "--seed", str(job["seed"]),
                     "--max_iterations", "10000", "--save_interval", "10000", "--save_optimizer", "False",
                     "--log_interval", "10", "--tensorboard_path", str(out), "--use_tensorboard", "False",
                     "--source_architecture", job["source_architecture"], "--source_shared_bias", "fixed", *flags]
        if job['arm'] == 'biased':
            raise RuntimeError('Biased is pending; it is not authorized in this sweep')
        (out / 'commands.json').write_text(json.dumps(dict(train=train_cmd), indent=2) + '\n')
        status.write_text("training\n")
        with (out / "train.log").open("w") as log:
            subprocess.run(train_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
        subprocess.run([sys.executable, str(Path(plan['sweep']) / 'operations/check_control.py'), str(out), job['arm'], job['source_architecture']], check=True)
        status.write_text("evaluating-valfull\n")
        eval_cmd = [sys.executable, "-u", "scripts/sample_wfm.py", "--model_path",
                    str(out / "checkpoints/wfm_unified_010000.pt"), "--data_dir", str(val),
                    "--output_dir", str(out / "eval-valfull-euler1-avail3-10000"),
                    "--contr", "all", "--sampling_steps", "1", "--num_samples", "-1", "--seed", "42",
                    "--sigma_max", str(job["sigma"]), "--num_available", "3", "--metrics_only", "True"]
        (out / "commands.json").write_text(json.dumps(dict(train=train_cmd, evaluation=eval_cmd), indent=2) + "\n")
        with (out / "eval-valfull.log").open("w") as log:
            subprocess.run(eval_cmd, check=True, stdout=log, stderr=subprocess.STDOUT)
        rows = json.loads((out / "eval-valfull-euler1-avail3-10000/metrics.json").read_text())
        assert set(rows) == {"t1n", "t1c", "t2w", "t2f"}
        for modality, values in rows.items():
            assert len(values) == 219 and {r["subject"] for r in values} == set(splits["valfull"]), modality
            assert all(math.isfinite(r["masked"][key]) for r in values for key in ("ssim", "psnr"))
        runtime["finished_utc"] = datetime.now(timezone.utc).isoformat()
        runtime['host'] = plan['host']
        (out / "runtime.json").write_text(json.dumps(runtime, indent=2) + "\n")
        status.write_text("complete\n")
    except BaseException as error:
        status.write_text(f"failed: {type(error).__name__}: {error}\n")
        raise


if __name__ == "__main__":
    main()
"""Check the completed B4 control and all recorded patient/target assignments."""
import csv
import json
import math
from collections import defaultdict
from pathlib import Path
import sys

import torch

sys.path.insert(0, str(Path.cwd()))
sys.path.insert(0, str(Path.cwd() / 'scripts'))
from guided_diffusion.source import ALL_MODALITIES, StartingSource, load_source
from patient_batching import patient_id

directory, arm, architecture = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
assert arm in ('mean', 'uniform') and architecture == 'conditional'
summary = json.loads((directory / 'training_summary.json').read_text())
assert summary['batch_size'] == 4 and summary['mixed_targets'] is True
assert summary['optimizer_updates'] == 10000 and summary['training_examples'] == 40000
assert summary['observed_model_input_shape'][:2] == [4, 32]
groups = defaultdict(list)
for row in csv.DictReader((directory / 'batch_targets.csv').open()):
    groups[int(row['step'])].append(row)
assert set(groups) == set(range(1, 10001))
for rows in groups.values():
    assert len(rows) == 4 and {int(r['sample']) for r in rows} == {0, 1, 2, 3}
    assert len({patient_id(r['subject']) for r in rows}) == 4
    assert {r['target'] for r in rows} == set(ALL_MODALITIES)
    for row in rows:
        assert {row[f'condition_{i}'] for i in (1, 2, 3)} == set(ALL_MODALITIES) - {row['target']}
progress = list(csv.DictReader((directory / 'progress.csv').open()))
assert int(progress[-1]['step']) == 10000
assert all(math.isfinite(float(row['loss'])) for row in progress)
source = load_source(directory / 'checkpoints/source_unified_010000.pt')
assert source.architecture == architecture and source.seed == 43
if arm == 'uniform':
    assert source.mode == 'learned' and source.init == 'uniform'
    assert hasattr(source, 'net') and source.prior_logits.shape == (4, 4, 8)
    assert not hasattr(source, 'table_logits')
    initial = StartingSource(**source.config())
    assert all(torch.isfinite(p).all() for p in source.parameters())
    assert any(not torch.equal(v, initial.state_dict()[k]) for k, v in source.state_dict().items())
else:
    assert source.mode == 'mean' and not list(source.parameters())
assert (directory / 'checkpoints/wfm_unified_010000.pt').is_file()
assert not list((directory / 'checkpoints').glob('opt_*.pt'))
print('PASS: completed 10000 physical B4 updates, distinct patients/targets, correct source, finite losses.')
"""Compare the conditional source to the historical implementation and mixed-batch gradients."""
import copy
import json
from pathlib import Path
import sys

import torch as th

sys.path.insert(0, str(Path.cwd()))
sys.path.insert(0, str(Path.cwd() / 'scripts'))
from guided_diffusion.source import ALL_MODALITIES, StartingSource
from guided_diffusion.wfm import WaveletFlowMatching
from check_mixed_batch import Probe
from historical_source import StartingSource as HistoricalSource

th.set_num_threads(1)
generator = th.Generator().manual_seed(91)
images = {m: th.randn(4, 1, 16, 16, 16, generator=generator) + i
          for i, m in enumerate(ALL_MODALITIES)}
targets = ['t2f', 't1n', 't1c', 't2w']
wfm = WaveletFlowMatching(sigma_max=.5)
target, _, coeff, names, available, labels = wfm.prepare_conditions(images, targets)
current = StartingSource('learned', 'uniform', seed=43, architecture='conditional')
historical = HistoricalSource('learned', 'uniform', seed=43)
assert current.config() == historical.config()
assert set(current.state_dict()) == set(historical.state_dict())
for key, value in current.state_dict().items():
    th.testing.assert_close(value, historical.state_dict()[key], rtol=0, atol=0)
_, initial_weights = current(coeff, names, targets, available)
th.testing.assert_close(initial_weights, th.full((4, 3, 8), 1 / 3))
# Nonuniform parameters ensure the comparison tests modality routing, not just 1/3.
with th.no_grad():
    current.net[-1].weight.copy_(th.randn(current.net[-1].weight.shape, generator=generator) * .03)
    current.prior_logits.copy_(th.randn(current.prior_logits.shape, generator=generator) * .1)
historical.load_state_dict(current.state_dict())
output, weights = current(coeff, names, targets, available)
reference, reference_weights = [], []
for row, target_name in enumerate(targets):
    s, a = historical(coeff[row:row+1], names[row], target_name, available[row:row+1])
    reference.append(s)
    reference_weights.append(a)
th.testing.assert_close(output, th.cat(reference), atol=1e-6, rtol=1e-5)
th.testing.assert_close(weights, th.cat(reference_weights), atol=1e-6, rtol=1e-5)
output.square().mean().backward()
th.cat(reference).square().mean().backward()
for (_, p), (_, q) in zip(current.named_parameters(), historical.named_parameters()):
    th.testing.assert_close(p.grad, q.grad, atol=1e-6, rtol=1e-5)

noise = th.randn(target.shape, generator=generator)
t = th.tensor([0, 127, 502, 999])
for mode in ('mean', 'learned'):
    source = copy.deepcopy(current) if mode == 'learned' else StartingSource('mean', seed=43)
    source.zero_grad()
    model = Probe()
    reference_model, reference_source = copy.deepcopy(model), copy.deepcopy(source)
    losses, _, _ = wfm.training_losses(model, images, t, source, contr=targets, noise=noise)
    loss = losses['mse_wav'].mean()
    loss.backward()
    row_losses = []
    for row, target_name in enumerate(targets):
        one = {m: v[row:row+1] for m, v in images.items()}
        row_loss, _, _ = wfm.training_losses(reference_model, one, t[row:row+1], reference_source,
                                             contr=target_name, noise=noise[row:row+1])
        row_losses.append(row_loss['mse_wav'].mean())
    reference_loss = th.stack(row_losses).mean()
    reference_loss.backward()
    th.testing.assert_close(loss, reference_loss)
    th.testing.assert_close(model.weight.grad, reference_model.weight.grad, atol=1e-6, rtol=1e-5)
    for p, q in zip(source.parameters(), reference_source.parameters()):
        th.testing.assert_close(p.grad, q.grad, atol=1e-6, rtol=1e-5)
    assert len(model.calls) == 1 and model.calls[0][0].shape[0] == 4
    assert model.calls[0][2].tolist() == [3, 0, 1, 2]
result = dict(passed=True, historical_initialization_equal=True,
              historical_source_forward_and_gradients_equal=True,
              physical_b4_loss_and_gradient_equivalence=True,
              old_source_parameters=sum(p.numel() for p in current.parameters()),
              effective_weights_per_sample=24, shared_table=False)
Path(sys.argv[1]).write_text(json.dumps(result, indent=2) + '\n')
print(json.dumps(result))
"""Submit exactly one B4 control on this host, with an exclusive submission guard."""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

path = Path(sys.argv[1]).resolve()
plan = json.loads(path.read_text())
sweep, code = Path(plan['sweep']), Path(plan['code'])
assert path == sweep / 'run_plan.json'
assert plan['host'] in ('mostafa', 'hendrix') and plan['seed'] == 43
assert plan['batch_size'] == 4 and plan['mixed_targets'] and plan['use_checkpoint']
assert plan['iterations'] == 10000 and plan['examples_per_run'] == 40000
assert plan['evaluation_seed'] == 42 and plan['sampling_steps'] == 1
assert plan['source_architecture'] == 'conditional' and plan['validation_cases'] == 219
assert len(plan['jobs']) == 1
job = plan['jobs'][0]
assert job['arm'] == ('uniform' if plan['host'] == 'hendrix' else 'mean')
assert job['seed'] == 43 and job['sigma'] == .5 and job['batch_size'] == 4
assert job['source_architecture'] == 'conditional' and job['index'] == 0
for filename, base in [('code_sha256.json', code), ('operations_sha256.json', sweep / 'operations')]:
    for name, digest in json.loads((sweep / filename).read_text()).items():
        assert hashlib.sha256((base / name).read_bytes()).hexdigest() == digest, name
assert not (sweep / 'submission_started.json').exists(), 'Inspect existing submission; never blindly resubmit'
if plan['host'] == 'hendrix':
    sys.path.insert(0, str(code / 'scripts'))
    from slurm_queue import wait_for_queue_room
    wait_for_queue_room(additional=2)
directory = Path(job['directory'])
assert directory.parent == sweep / 'runs'
directory.mkdir(parents=True, exist_ok=True)
status = directory / 'status.txt'
if status.exists():
    assert status.read_text().strip() == 'queued'
status.write_text('queued\n')
(directory / 'config.json').write_text(json.dumps(job, indent=2) + '\n')
subprocess.run([sys.executable, str(sweep / 'operations/run_control.py'), str(path), '0', '--preflight-only'],
               cwd=code, check=True, env={**os.environ, 'PYTORCH_CUDA_ALLOC_CONF': 'max_split_size_mb:128'})
with (sweep / 'submission_started.json').open('x') as stream:
    json.dump({'started_utc': datetime.now(timezone.utc).isoformat()}, stream)
(sweep / 'status.txt').write_text('submitted\n')
command = ['sbatch', '--parsable', f"--job-name=b4-{job['arm']}-s05-s43",
           f'--output={sweep}/train-%j.log', f'--chdir={code}', '--time=36:00:00',
           '--gpus=a100:1' if plan['host'] == 'hendrix' else '--gpus=1',
           str(sweep / 'operations/train.sbatch'), str(path)]
job['slurm_job_id'] = subprocess.check_output(command, text=True).strip().split(';')[0]
assert job['slurm_job_id'].isdigit()
path.write_text(json.dumps(plan, indent=2) + '\n')
callback = subprocess.check_output([
    'sbatch', '--parsable', '--partition=gpu', '--cpus-per-task=1', '--mem=2G', '--time=00:10:00',
    f"--job-name=b4-{job['arm']}-finish", f"--dependency=afterany:{job['slurm_job_id']}",
    f'--output={sweep}/finish.log', f'--chdir={code}',
    str(code / 'scripts/slurm/shared_report.sbatch'), str(path)], text=True).strip().split(';')[0]
assert callback.isdigit()
plan['report_job_id'] = callback
plan['submitted_utc'] = datetime.now(timezone.utc).isoformat()
path.write_text(json.dumps(plan, indent=2) + '\n')
(sweep / 'submission_complete.json').write_text(json.dumps(plan, indent=2) + '\n')
print(json.dumps({'host': plan['host'], 'training_job': job['slurm_job_id'], 'callback': callback}))
#!/usr/bin/env bash
