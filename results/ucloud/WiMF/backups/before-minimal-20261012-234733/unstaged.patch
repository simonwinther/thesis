+    """Inspect both embedding inputs and their exact unit-time JVP tangents."""
+    import guided_diffusion.wimf_model as model_module
+
+    original_embedding = model_module.timestep_embedding
+    observed = []
+
+    def record_embedding(times, width):
+        observed.append(torch.autograd.forward_ad.unpack_dual(times))
+        return original_embedding(times, width)
+
+    monkeypatch.setattr(model_module, "timestep_embedding", record_embedding)
+    tiny_model.time_feature_scale = scale
