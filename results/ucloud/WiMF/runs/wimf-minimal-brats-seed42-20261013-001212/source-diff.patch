index be71c11..1a8e0d9 100644
--- a/guided_diffusion/wfm.py
+++ b/guided_diffusion/wfm.py
@@ -414,3 +414,120 @@ class WaveletFlowMatching:
         output_img[cond_1 == 0] = 0  # Zero out non-brain regions
 
         return output_img, target
+
+
+class WaveletImprovedMeanFlow(WaveletFlowMatching):
+    """Algorithm 1 of iMF, using WFM's three-modality informed endpoint.
+
+    With target coefficients x and condition mean m(C), draw e=m(C)+sigma*W(eps)
+    once, then use z_t=(1-t)x+t*e and path velocity e-x. Thus t=0 is data and
+    t=1 is the prior, reversing WFM's clock. W is the unchanged scaled Haar DWT.
+    All states are [B,8,H/2,W/2,D/2]; C has 24 channels; r,t are physical [B]
+    times. The conditional U-Net sees WFM's 1000*t clock plus physical h=t-r.
+
+    We use the paper's single-head boundary variant v=u(z,t,t), without CFG or
+    an auxiliary velocity head. Coefficient-mean L2 deliberately retains WFM's
+    reduction rather than the official implementation's adaptive weighting.
+    The default sigma=0 retains WFM's mean endpoint, but is a Dirac conditional
+    prior; it is not the paper's Gaussian prior or a validated quality recipe.
+    """
+
+    def __init__(self, num_timesteps=1000, sigma_max=0.5, mode='i2i', prior_sigma=0.0):
+        # Keep the constructor compatible; WFM's interior bridge noise is unused.
+        super().__init__(num_timesteps=num_timesteps, sigma_max=sigma_max, mode=mode)
+        if not np.isfinite(prior_sigma) or prior_sigma < 0:
+            raise ValueError("prior_sigma must be finite and nonnegative")
+        self.prior_sigma = prior_sigma
+
+    def sample_times(self, batch_size, device):
+        """Official logit-normal times; first floor(B/2) rows have r=t."""
+        times = th.sigmoid(th.randn(2, batch_size, device=device) - 0.4)
+        r, t = times.min(dim=0).values, times.max(dim=0).values
+        r[:batch_size // 2] = t[:batch_size // 2]
+        return r, t
+
+    def _prior(self, mean, image=None, noise=None):
+        """Optional endpoint noise is drawn in image space, matching WFM's DWT."""
+        if self.prior_sigma == 0:
+            return mean  # Preserve RNG state when retaining the deterministic prior.
+        if noise is None:
+            if image is None:
+                image = apply_idwt(mean)
+            noise = th.randn_like(image)
+        return mean + self.prior_sigma * apply_dwt(noise)
+
+    def training_losses(self, model, x_start, t=None, model_kwargs=None, noise=None,
+                        mode='i2i', contr='t1n'):
+        """Return WFM-compatible per-band losses, mean velocity, and train image.
+
+        D = J_z u * stopgrad(u(z,t,t)) + partial_t u, holding r,C,y fixed.
+        V = u + (t-r)*stopgrad(D), and L=mean((V-(e-x))^2). The JVP receives
+        physical-time tangents (v,0,1); 1000*t and h=t-r stay INSIDE its closure
+        so both embedding chain rules are included. No parameter gradient may
+        pass through either the learned JVP direction or its derivative result.
+
+        The image diagnostic z_t-t*V estimates the clean target during training;
+        it is not the actual 1-NFE prediction from a prior-only input.
+        """
+        model_kwargs = {} if model_kwargs is None else model_kwargs
+        target, conditions, class_idx = self._get_target_and_conditions(x_start, contr)
+
+        # Reuse WFM's target exclusion, channel order, DWT, and informed mean.
+        condition_bands = [apply_dwt(image) for image in conditions]
+        cond = th.cat(condition_bands, dim=1)
+        x = apply_dwt(target)
+        e = self._prior(sum(condition_bands) / 3.0, image=target, noise=noise)
+        batch_size = x.shape[0]
+        y = th.full((batch_size,), class_idx, device=x.device, dtype=th.long)
+
+        # WiMF accepts continuous interval pairs, never WFM's integer timestep.
+        if t is None:
+            r, t = self.sample_times(batch_size, x.device)
+        elif isinstance(t, (tuple, list)) and len(t) == 2:
+            r, t = t
+        else:
+            raise ValueError("WiMF requires (r,t) physical times or t=None")
+        if (r.shape != (batch_size,) or t.shape != (batch_size,)
+                or not th.isfinite(r).all() or not th.isfinite(t).all()
+                or th.any(r < 0) or th.any(r > t) or th.any(t > 1)):
+            raise ValueError("WiMF intervals must have shape [B] and 0 <= r <= t <= 1")
+        t_view, h = t.view(-1, 1, 1, 1, 1), (t-r).view(-1, 1, 1, 1, 1)
+        z = (1-t_view) * x + t_view * e
+
+        def u_fn(state, lower, upper):
+            return model(th.cat([state, cond], dim=1), self._scale_timesteps(upper),
+                         y=y, intervals=upper-lower, **model_kwargs)
+
+        # Forward AD still works under no_grad; no unused backward graph survives.
+        with th.no_grad():
+            v = u_fn(z, t, t)
+            _, derivative = th.func.jvp(
+                u_fn, (z, r, t), (v, th.zeros_like(r), th.ones_like(t)))
+
+        # Recompute only the primal with parameter gradients, as required by iMF.
+        u = u_fn(z, r, t)
+        V = u + h * derivative.detach()
+        per_band = mean_flat((V-(e-x)) ** 2).mean(dim=0)
+        terms = {"mse_wav": per_band, "loss": per_band.mean()}
+        train_image = apply_idwt((z-t_view*V).detach())
+        return terms, u, train_image
+
+    @th.no_grad()
+    def p_sample_loop(self, model, shape, cond, source, y=None, num_steps=1,
+                      device=None, progress=True, clip_denoised=True,
+                      model_kwargs=None, solver='euler'):
+        """One network evaluation: x_hat=e-u(e,r=0,t=1), with fixed conditions.
+
+        source is WFM's condition mean [B,8,H/2,W/2,D/2]. Optional endpoint
+        noise uses precisely the same image-space distribution as in training.
+        WFM's image-domain clipping remains unchanged; there is no sampling JVP.
+        """
+        if num_steps != 1:
+            raise ValueError("WiMF sampling requires num_steps=1 (exactly 1 NFE)")
+        model_kwargs = {} if model_kwargs is None else model_kwargs
+        e = self._prior(source)
+        one = th.ones(e.shape[0], device=e.device, dtype=e.dtype)
+        u = model(th.cat([e, cond], dim=1), self._scale_timesteps(one),
+                  y=y, intervals=one, **model_kwargs)
+        output = e-u
+        return self._clip_wavelets(output) if clip_denoised else output
